local function removeFlyMovers()
    if flyBV then safeDestroy(flyBV); flyBV = nil end
    if flyBG then safeDestroy(flyBG); flyBG = nil end
end

local function syncFlyUI()
    if not uiRefs.flyBtn then return end
    if isFlying then
        uiRefs.flyBtn.Text = "⏹️  ปิดบินอิสระ"
        uiRefs.flyBtn.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    else
        uiRefs.flyBtn.Text = "🕊️  บินอิสระตัวละคร: ปิด"
        uiRefs.flyBtn.BackgroundColor3 = Color3.fromRGB(90, 60, 160)
    end
    updateTouchPadVisibility()
end

local function stopFly()
    isFlying = false
    if flyLoop then flyLoop:Disconnect(); flyLoop = nil end
    removeFlyMovers()
    resetTouchHeld()

    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end)
    end
    syncFlyUI()
    if uiRefs.status and not isEnabled then
        uiRefs.status.Text = "⏸️  สถานะ: ปิดอยู่"
        uiRefs.status.TextColor3 = Color3.fromRGB(255, 180, 80)
    end
end

local function createFlyMovers(root)
    removeFlyMovers()
    for _, c in ipairs(root:GetChildren()) do
        if c.Name == "AB_FlyBV" or c.Name == "AB_FlyBG" then
            safeDestroy(c)
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "AB_FlyBV"
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Velocity = Vector3.new(0, 0, 0)
    flyBV.P = 5000
    flyBV.Parent = root

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "AB_FlyBG"
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.P = 10000
    flyBG.D = 500
    flyBG.CFrame = root.CFrame
    flyBG.Parent = root
end

local function startFly()
    local char = Player.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then
        return false
    end

    -- หยุดขับเรือก่อนถ้ากำลังเปิดอยู่ (กันแย่งควบคุมกัน)
    if isEnabled then
        stopSystem()
    end
    if hum.SeatPart then
        hum.Sit = false
        task.wait(0.05)
    end

    stopFly()
    isFlying = true

    createFlyMovers(root)
    hum.PlatformStand = true
    syncFlyUI()
    if uiRefs.status then
        uiRefs.status.Text = "🕊️  กำลังบินอิสระ (จอย/WASD + ขึ้นลง)"
        uiRefs.status.TextColor3 = Color3.fromRGB(190, 150, 255)
    end

    flyLoop = RunService.RenderStepped:Connect(function()
        if not isFlying then
            stopFly()
            return
        end

        local c = Player.Character
        local r = c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso"))
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h or h.Health <= 0 or h.SeatPart then
            stopFly()
            return
        end

        if not flyBV or flyBV.Parent ~= r or not flyBG or flyBG.Parent ~= r then
            createFlyMovers(r)
        end

        h.PlatformStand = true

        local cam = workspace.CurrentCamera
        if not cam then return end
        local camCF = cam.CFrame

        local moveDir = Vector3.new(0, 0, 0)
        local keyActive = pressing(Enum.KeyCode.W) or pressing(Enum.KeyCode.S)
            or pressing(Enum.KeyCode.A) or pressing(Enum.KeyCode.D)

        if keyActive then
            if pressing(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
            if pressing(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
            if pressing(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
            if pressing(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
        else
            local thumb = getThumbstickVector()
            if thumb and thumb.Magnitude > 0.05 then
                moveDir = moveDir + camCF.LookVector * (-thumb.Z) + camCF.RightVector * thumb.X
            elseif h.MoveDirection.Magnitude > 0.05 then
                -- fallback: แปลง MoveDirection ให้บิน 3 มิติตามมุมกล้อง
                local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
                local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
                if flatLook.Magnitude > 0.01 and flatRight.Magnitude > 0.01 then
                    local fwdAmt = h.MoveDirection:Dot(flatLook.Unit)
                    local rightAmt = h.MoveDirection:Dot(flatRight.Unit)
                    moveDir = moveDir + camCF.LookVector * fwdAmt + camCF.RightVector * rightAmt
                end
            end
        end

        if touchHeld.left then moveDir = moveDir - camCF.RightVector end
        if touchHeld.right then moveDir = moveDir + camCF.RightVector end
        if pressing(Enum.KeyCode.Space) or touchHeld.up then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if pressing(Enum.KeyCode.LeftControl) or touchHeld.down then moveDir = moveDir - Vector3.new(0, 1, 0) end

        if moveDir.Magnitude > 0 then
            flyBV.Velocity = moveDir.Unit * flySpeed
        else
            flyBV.Velocity = Vector3.new(0, 0, 0)
        end

        local lookXZ = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        if lookXZ.Magnitude > 0.01 then
            flyBG.CFrame = CFrame.lookAt(Vector3.new(0, 0, 0), lookXZ)
        end
    end)

    return true
end

-- ============================================
-- Helper ลากหน้าต่าง (รองรับทั้งนิ้วทัชและเมาส์)
-- ============================================
local function makeDraggable(handle, target, onTap)
    local dragging = false
    local dragInput = nil
    local startPos = nil
    local startFramePos = nil
    local moved = false

    local function finishDrag()
        if not dragging then return end
        dragging = false
        dragInput = nil
        if not moved and onTap then
            onTap()
        end
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = input
            startPos = input.Position
            startFramePos = target.Position
            moved = false

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    finishDrag()
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            dragInput = input
        end
    end)

    trackConn(UIS.InputChanged:Connect(function(input)
        if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - startPos
            if delta.Magnitude > 8 then
                moved = true
            end
            target.Position = UDim2.new(
                startFramePos.X.Scale,
                startFramePos.X.Offset + delta.X,
                startFramePos.Y.Scale,
                startFramePos.Y.Offset + delta.Y
            )
        end
    end))

    trackConn(UIS.InputEnded:Connect(function(input)
        if dragging and input == dragInput then
            finishDrag()
        end
    end))
end

local function bindHoldButton(btn, flagName, activeCol, idleCol)
    uiRefs.padButtons = uiRefs.padButtons or {}
    table.insert(uiRefs.padButtons, { btn = btn, idleCol = idleCol })

    local activeInput = nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeInput = input
            touchHeld[flagName] = true
            btn.BackgroundColor3 = activeCol
        end
    end)

    trackConn(UIS.InputEnded:Connect(function(input)
        if activeInput and input == activeInput then
            activeInput = nil
            touchHeld[flagName] = false
            btn.BackgroundColor3 = idleCol
        end
    end))
end

