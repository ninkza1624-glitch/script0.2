-- ============================================
-- หา Seat + Boat Model (ระบบ v4.1 เดิม)
-- ============================================
local function getSeat()
    local char = Player.Character
    if not char then return nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return nil, nil end
    local seat = hum.SeatPart
    local boat = seat:FindFirstAncestorOfClass("Model")
    if boat and boat ~= char then
        return seat, boat
    end
    return seat, seat.Parent
end

-- ============================================
-- ขอ Network Ownership ทุกชิ้นของเรือ (ระบบ v4.1 เดิม)
-- ============================================
local function claimOwnership(boat)
    if not boat then return end
    pcall(function()
        for _, part in ipairs(boat:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part:SetNetworkOwner(Player)
                end)
            end
        end
    end)
end

-- ============================================
-- ลบ BodyMovers (ระบบ v4.1 เดิม)
-- ============================================
local function removeMovers()
    if bv then pcall(game.Destroy, bv); bv = nil end
    if bg then pcall(game.Destroy, bg); bg = nil end
    if bp then pcall(game.Destroy, bp); bp = nil end
end

local function cleanOld(seat)
    for _, c in ipairs(seat:GetChildren()) do
        if c.Name:sub(1, 3) == "AB_" then
            pcall(game.Destroy, c)
        end
    end
end

-- ============================================
-- สร้าง BodyMovers ที่ Seat (ระบบ v4.1 เดิม)
-- ============================================
local function createMovers(seat)
    removeMovers()
    cleanOld(seat)

    bv = Instance.new("BodyVelocity")
    bv.Name = "AB_BV"
    bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.P = 1250
    bv.Parent = seat

    bg = Instance.new("BodyGyro")
    bg.Name = "AB_BG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 3000
    bg.D = 300
    bg.Parent = seat

    bp = Instance.new("BodyPosition")
    bp.Name = "AB_BP"
    bp.MaxForce = Vector3.new(0, math.huge, 0)
    bp.P = 3000
    bp.D = 600
    bp.Position = Vector3.new(seat.Position.X, boatHeight, seat.Position.Z)
    bp.Parent = seat
end

-- ============================================
-- เริ่มระบบขับเรือ (ระบบ v4.1 เดิม)
-- ============================================
local function startSystem()
    local seat, boat = getSeat()
    if not seat then
        warn("[Boat] ❌ นั่งเรือก่อน!")
        return false
    end

    isEnabled = true
    boatHeight = seat.Position.Y

    local _, y, _ = seat.CFrame:ToEulerAnglesYXZ()
    currentYaw = y

    -- ขอ Network Ownership
    claimOwnership(boat)

    -- ลบ constraints ที่เกมใช้ควบคุมเรือ (ป้องกันตีกัน)
    pcall(function()
        for _, v in ipairs(boat:GetDescendants()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") or v:IsA("BodyPosition")
                or v:IsA("BodyForce") or v:IsA("BodyThrust") then
                if v.Name ~= "AB_BV" and v.Name ~= "AB_BG" and v.Name ~= "AB_BP" then
                    v:Destroy()
                end
            end
            -- ลบ LinearVelocity, AlignOrientation ด้วย (Roblox ใหม่)
            if v:IsA("LinearVelocity") or v:IsA("AlignOrientation")
                or v:IsA("AlignPosition") or v:IsA("AngularVelocity") then
                v:Destroy()
            end
        end
    end)

    createMovers(seat)

    if mainLoop then mainLoop:Disconnect() end

    mainLoop = RunService.Heartbeat:Connect(function(dt)
        if not isEnabled then
            removeMovers()
            if mainLoop then mainLoop:Disconnect(); mainLoop = nil end
            return
        end

        local s, b = getSeat()
        if not s then
            isEnabled = false
            isAutoDrive = false
            removeMovers()
            resetTouchHeld()
            if mainLoop then mainLoop:Disconnect(); mainLoop = nil end
            syncBoatUI()
            return
        end

        if not bv or bv.Parent ~= s then
            claimOwnership(b)
            createMovers(s)
        end

        -- Q/E หรือปุ่มทัชบนจอ ปรับความสูง
        if pressing(Enum.KeyCode.Q) or touchHeld.up then
            boatHeight = math.min(5000, boatHeight + 80 * dt)
        end
        if pressing(Enum.KeyCode.E) or touchHeld.down then
            boatHeight = math.max(-50, boatHeight - 80 * dt)
        end

        -- คำนวณทิศทางกล้องบนระนาบ (สำหรับจอยสติ๊กมือถือ fallback)
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local cam = workspace.CurrentCamera
        local camFlatLook, camFlatRight = nil, nil
        if cam then
            local lv = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            local rv = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
            if lv.Magnitude > 0.01 then camFlatLook = lv.Unit end
            if rv.Magnitude > 0.01 then camFlatRight = rv.Unit end
        end

        -- A/D หรือปุ่มทัช หรือจอยสติ๊กมือถือ เลี้ยว
        local thumb = getThumbstickVector()
        local turn = 0
        if pressing(Enum.KeyCode.A) or touchHeld.left then turn = turn + 1 end
        if pressing(Enum.KeyCode.D) or touchHeld.right then turn = turn - 1 end
        if turn == 0 then
            if s:IsA("VehicleSeat") and math.abs(s.SteerFloat or 0) > 0.05 then
                turn = -(s.SteerFloat or 0)
            elseif thumb and math.abs(thumb.X) > 0.08 then
                turn = -thumb.X
            elseif hum and hum.MoveDirection.Magnitude > 0.1 and camFlatRight then
                local rDot = hum.MoveDirection:Dot(camFlatRight)
                if math.abs(rDot) > 0.1 then
                    turn = -rDot
                end
            end
        end
        currentYaw = currentYaw + turn * turnSpeed * dt

        -- BodyGyro — ล็อคให้เรือตั้งตรง + หมุนตาม yaw
        bg.CFrame = CFrame.Angles(0, currentYaw, 0)

        -- W/S หรือจอยสติ๊กมือถือ ขับเดินหน้า/ถอยหลัง
        local fwd = Vector3.new(-math.sin(currentYaw), 0, -math.cos(currentYaw))
        local speed = 0
        if pressing(Enum.KeyCode.W) or isAutoDrive then
            speed = boatSpeed
        elseif pressing(Enum.KeyCode.S) then
            speed = -boatSpeed * 0.4
        elseif s:IsA("VehicleSeat") and math.abs(s.ThrottleFloat or 0) > 0.05 then
            local tf = s.ThrottleFloat
            speed = tf > 0 and (boatSpeed * tf) or (boatSpeed * 0.4 * tf)
        elseif thumb and math.abs(thumb.Z) > 0.08 then
            local tf = -thumb.Z
            speed = tf > 0 and (boatSpeed * tf) or (boatSpeed * 0.4 * tf)
        elseif hum and hum.MoveDirection.Magnitude > 0.1 and camFlatLook then
            local fDot = hum.MoveDirection:Dot(camFlatLook)
            if fDot > 0.1 then
                speed = boatSpeed * fDot
            elseif fDot < -0.1 then
                speed = boatSpeed * 0.4 * fDot
            end
        end

        bv.Velocity = fwd * speed
        bp.Position = Vector3.new(s.Position.X, boatHeight, s.Position.Z)
    end)

    syncBoatUI()
    return true
end

local function stopSystem()
    isEnabled = false
    isAutoDrive = false
    removeMovers()
    resetTouchHeld()
    if mainLoop then mainLoop:Disconnect(); mainLoop = nil end
    syncBoatUI()
end

