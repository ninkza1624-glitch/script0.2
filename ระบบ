-- ============================================
-- ระบบ ESP ชื่อผู้เล่น (Drawing API + BillboardGui Fallback)
-- ============================================
local hasDrawing = pcall(function()
    local t = Drawing.new("Text")
    if t.Remove then t:Remove() elseif t.Destroy then t:Destroy() end
end)

local espFolder = nil
local espAttachFolder = nil
local espEntries = {}

local function safeDestroy(obj)
    if not obj then return end
    pcall(function()
        if obj.Remove then
            obj:Remove()
        elseif obj.Destroy then
            obj:Destroy()
        end
    end)
end

local function getEspFolder()
    local parent = guiParent()
    if espFolder and espFolder.Parent == parent then
        return espFolder
    end
    local old = parent:FindFirstChild("AutoBoatESP")
    if old then old:Destroy() end
    espFolder = Instance.new("Folder")
    espFolder.Name = "AutoBoatESP"
    espFolder.Parent = parent
    return espFolder
end

local function getAttachFolder()
    if espAttachFolder and espAttachFolder.Parent == workspace.Terrain then
        return espAttachFolder
    end
    local old = workspace.Terrain:FindFirstChild("AutoBoatESP_Attach")
    if old then old:Destroy() end
    espAttachFolder = Instance.new("Folder")
    espAttachFolder.Name = "AutoBoatESP_Attach"
    espAttachFolder.Parent = workspace.Terrain
    return espAttachFolder
end

local function getPlayerColor(plr)
    if plr.Team and plr.TeamColor then
        return plr.TeamColor.Color
    end
    return Color3.fromRGB(255, 240, 120)
end

local function getDisplayText(plr)
    if plr.DisplayName ~= plr.Name then
        return plr.DisplayName .. " (@" .. plr.Name .. ")"
    end
    return plr.Name
end

local function getPlayerTarget(plr)
    local char = plr.Character
    if not char then
        local charsFolder = workspace:FindFirstChild("Characters")
        if charsFolder then
            char = charsFolder:FindFirstChild(plr.Name)
        end
    end
    if not char then return nil, nil, nil, false end

    local part = char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
        or char.PrimaryPart
        or char:FindFirstChildWhichIsA("BasePart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if part and part:IsA("BasePart") then
        return part, part.Position, hum, true
    end

    -- กรณีอยู่ไกลจนชิ้นส่วนถูก Streaming ถอดออก แต่ Model ยังอยู่
    local ok, pivot = pcall(function() return char:GetPivot() end)
    if ok and pivot and pivot.Position.Magnitude > 1 then
        return nil, pivot.Position, hum, false
    end

    return nil, nil, nil, false
end

local function removeEspForPlayer(plr)
    local entry = espEntries[plr]
    if entry then
        if entry.nameDraw then safeDestroy(entry.nameDraw) end
        if entry.infoDraw then safeDestroy(entry.infoDraw) end
        if entry.gui then safeDestroy(entry.gui) end
        if entry.attach then safeDestroy(entry.attach) end
        espEntries[plr] = nil
    end
end

local function createEspForPlayer(plr)
    if plr == Player or espEntries[plr] then return end

    if hasDrawing then
        local nameDraw = Drawing.new("Text")
        nameDraw.Visible = false
        nameDraw.Center = true
        nameDraw.Outline = true
        nameDraw.OutlineColor = Color3.new(0, 0, 0)
        nameDraw.Size = 15
        nameDraw.Color = getPlayerColor(plr)
        nameDraw.Text = getDisplayText(plr)

        local infoDraw = Drawing.new("Text")
        infoDraw.Visible = false
        infoDraw.Center = true
        infoDraw.Outline = true
        infoDraw.OutlineColor = Color3.new(0, 0, 0)
        infoDraw.Size = 13
        infoDraw.Color = Color3.fromRGB(200, 255, 210)
        infoDraw.Text = ""

        espEntries[plr] = {
            mode = "drawing",
            nameDraw = nameDraw,
            infoDraw = infoDraw,
            lastInfoUpdate = 0,
        }
    else
        local folder = getEspFolder()

        local bb = Instance.new("BillboardGui")
        bb.Name = "ESP_" .. plr.Name
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 220, 0, 42)
        bb.StudsOffset = Vector3.new(0, 3.2, 0)
        bb.MaxDistance = math.huge
        bb.ResetOnSpawn = false
        bb.Enabled = false
        bb.Parent = folder

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, 0, 0, 20)
        nameLbl.Position = UDim2.new(0, 0, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = getDisplayText(plr)
        nameLbl.TextColor3 = getPlayerColor(plr)
        nameLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLbl.TextStrokeTransparency = 0
        nameLbl.TextSize = 14
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.Parent = bb

        local infoLbl = Instance.new("TextLabel")
        infoLbl.Size = UDim2.new(1, 0, 0, 18)
        infoLbl.Position = UDim2.new(0, 0, 0, 20)
        infoLbl.BackgroundTransparency = 1
        infoLbl.Text = ""
        infoLbl.TextColor3 = Color3.fromRGB(200, 255, 210)
        infoLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        infoLbl.TextStrokeTransparency = 0
        infoLbl.TextSize = 12
        infoLbl.Font = Enum.Font.Gotham
        infoLbl.Parent = bb

        espEntries[plr] = {
            mode = "billboard",
            gui = bb,
            nameLbl = nameLbl,
            infoLbl = infoLbl,
            attach = nil,
            lastInfoUpdate = 0,
        }
    end
end

local function formatInfoText(pos, myPos, hum, isLive)
    local distText = myPos and (math.floor((pos - myPos).Magnitude) .. "m") or "?m"
    local suffix = isLive and "" or " (ล่าสุด)"
    if hum and hum.MaxHealth > 0 then
        return string.format("[%s%s]  HP %d/%d", distText, suffix, math.floor(hum.Health), math.floor(hum.MaxHealth))
    end
    return string.format("[%s%s]", distText, suffix)
end

local function updateAllEsp(now)
    local cam = workspace.CurrentCamera
    local myChar = Player.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    local myPos = myRoot and myRoot.Position or (cam and cam.CFrame.Position) or nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            if not espEntries[plr] then
                createEspForPlayer(plr)
            end
            local entry = espEntries[plr]
            if entry then
                local part, worldPos, hum, isLive = getPlayerTarget(plr)

                if entry.mode == "drawing" then
                    if worldPos and cam then
                        local screenPos, onScreen = cam:WorldToViewportPoint(worldPos + Vector3.new(0, 3.5, 0))
                        if onScreen and screenPos.Z > 0 then
                            entry.nameDraw.Position = Vector2.new(screenPos.X, screenPos.Y - 14)
                            entry.infoDraw.Position = Vector2.new(screenPos.X, screenPos.Y + 2)
                            entry.nameDraw.Visible = true
                            entry.infoDraw.Visible = true

                            if now - entry.lastInfoUpdate >= 0.15 then
                                entry.lastInfoUpdate = now
                                entry.nameDraw.Color = getPlayerColor(plr)
                                entry.nameDraw.Text = getDisplayText(plr)
                                entry.infoDraw.Text = formatInfoText(worldPos, myPos, hum, isLive)
                            end
                        else
                            entry.nameDraw.Visible = false
                            entry.infoDraw.Visible = false
                        end
                    else
                        entry.nameDraw.Visible = false
                        entry.infoDraw.Visible = false
                    end
                elseif entry.gui then
                    if part then
                        entry.gui.Adornee = part
                        entry.gui.Enabled = true
                        if entry.attach then
                            safeDestroy(entry.attach)
                            entry.attach = nil
                        end
                    elseif worldPos then
                        if not entry.attach or not entry.attach.Parent then
                            local att = Instance.new("Attachment")
                            att.Name = "ATT_" .. plr.Name
                            att.Parent = getAttachFolder()
                            entry.attach = att
                        end
                        entry.attach.WorldPosition = worldPos
                        entry.gui.Adornee = entry.attach
                        entry.gui.Enabled = true
                    else
                        entry.gui.Adornee = nil
                        entry.gui.Enabled = false
                    end

                    if (part or worldPos) and (now - entry.lastInfoUpdate >= 0.15) then
                        entry.lastInfoUpdate = now
                        entry.nameLbl.TextColor3 = getPlayerColor(plr)
                        entry.infoLbl.Text = formatInfoText(worldPos, myPos, hum, isLive)
                    end
                end
            end
        end
    end
end

local function stopESP()
    isEspEnabled = false
    if espLoop then espLoop:Disconnect(); espLoop = nil end
    for plr, _ in pairs(espEntries) do
        removeEspForPlayer(plr)
    end
    if espFolder then
        safeDestroy(espFolder)
        espFolder = nil
    end
    if espAttachFolder then
        safeDestroy(espAttachFolder)
        espAttachFolder = nil
    end
end

local function startESP()
    stopESP()
    isEspEnabled = true
    if not hasDrawing then
        getEspFolder()
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        createEspForPlayer(plr)
    end
    updateAllEsp(os.clock())

    if hasDrawing then
        -- Drawing ต้องอัปเดตตำแหน่งหน้าจอทุกเฟรมเพื่อความลื่น
        espLoop = RunService.RenderStepped:Connect(function()
            if not isEspEnabled then return end
            updateAllEsp(os.clock())
        end)
    else
        local elapsed = 0
        espLoop = RunService.Heartbeat:Connect(function(dt)
            if not isEspEnabled then return end
            elapsed = elapsed + dt
            if elapsed < 0.1 then return end
            elapsed = 0
            updateAllEsp(os.clock())
        end)
    end
end

