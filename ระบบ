trackConn(UIS.InputBegan:Connect(function(input, gpe)
    if gpe or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        if uiRefs.main and uiRefs.miniBtn then
            local show = not uiRefs.main.Visible
            uiRefs.main.Visible = show
            uiRefs.miniBtn.Visible = not show
        end
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        if isFlying then
            stopFly()
        else
            startFly()
        end
    end
end))

trackConn(Player.CharacterAdded:Connect(function()
    task.wait(1)
    stopSystem()
    stopFly()
end))

pcall(function()
    if getgenv then
        getgenv().AB_Cleanup = function()
            stopSystem()
            stopFly()
            stopESP()
            for _, c in ipairs(globalConns) do
                pcall(function() c:Disconnect() end)
            end
            table.clear(globalConns)
            local g = guiParent():FindFirstChild("AutoBoatGUI")
            if g then g:Destroy() end
        end
    end
end)

